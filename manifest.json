{
  "manifest_version": 3,
  "name": "SSO Account Pin",
  "version": "1.0.0",
  "description": "Pin enterprise SSO sign-in to a specific Google account, skipping the account chooser when multiple accounts are signed in.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "optional_permissions": ["declarativeNetRequestFeedback"],
  "host_permissions": ["*://accounts.google.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "SSO Account Pin — Settings"
  }
}
